    "font": "tsx scripts/subset-font.ts",
    "api-types": "openapi-typescript ../game-api/openapi.yaml -o src/api/schema.ts",
    "audio": "tsx scripts/synthesize-audio.ts"
  },
  "dependencies": {
    "@react-three/drei": "^10.0.0",
    "@react-three/fiber": "^9.0.0",
    "next": "15.5.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "three": "^0.170.0",
    "zod": "^3.24.1",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@tailwindcss/postcss": "^4.1.16",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.17.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.170.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "15.5.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "openapi-typescript": "^7.4.0",
    "pinyin-pro": "^3.29.5",
    "postcss": "^8.4.49",
    "sharp": "^0.33.0",
    "subset-font": "^2.4.0",
    "tailwindcss": "^4.1.16",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3"
